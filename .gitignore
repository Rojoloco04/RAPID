*.exe
*.o
*.d
*.bin
*.pdi
*.lock

# Build output directories
/build/
/export/

# Logs
*.log
*.jou
*.backup.log
*.backup.jou
/logs/

# ============================================
# Xilinx Vivado project build artifacts
# ============================================

# Vivado generated/cache/run directories
RAPID/RAPID.cache/
RAPID/RAPID.gen/
RAPID/RAPID.hw/
RAPID/RAPID.runs/
RAPID/RAPID.sim/
RAPID/RAPID.tmp/
RAPID/RAPID.ioplanning/
RAPID/RAPID.ip_user_files/

# Vivado journals and logs (root of RAPID/)
RAPID/vivado.jou
RAPID/vivado.log
RAPID/vivado_*.backup.jou
RAPID/vivado_*.backup.log
RAPID/ip_upgrade.log
RAPID/dfx_runtime.txt

# Xilinx temporary directories
RAPID/.Xil/
RAPID/.rigel_lopper/

# Hardware export (can be regenerated from project)
RAPID/top_wrapper.xsa

# NA summary (auto-generated)
RAPID/NA/

