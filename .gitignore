# ============================================
# General build artifacts
# ============================================
*.exe
*.o
*.d
*.bin
*.pdi
*.lock

# Build output directories
/build/
/export/

# Logs
*.log
*.jou
*.backup.log
*.backup.jou
/logs/

# Python
__pycache__/
*.pyc
/.venv/
/venv/

# ============================================
# Xilinx Vivado project build artifacts
# ============================================

# Vivado generated/cache/run directories
hardware/RAPID.cache/
hardware/RAPID.hw/
hardware/RAPID.runs/
hardware/RAPID.sim/
hardware/RAPID.tmp/
hardware/RAPID.gen/
hardware/RAPID.ip_user_files/

# Vivado journals and logs (root of hardware/)
hardware/vivado.jou
hardware/vivado.log
hardware/vivado_*.backup.jou
hardware/vivado_*.backup.log
hardware/ip_upgrade.log
hardware/dfx_runtime.txt

# Xilinx temporary directories
hardware/.Xil/
hardware/.rigel_lopper/

# Hardware export (can be regenerated from project)
hardware/top_wrapper.xsa

# NA summary (auto-generated)
hardware/NA/

# ============================================
# Xilinx IDE caches (Vitis / Clangd)
# ============================================
.cache/
.clangd
compile_commands.json
.vitisWorkspace.json

# ============================================
# vitis_workspace build artifacts
# ============================================

# Workspace-level IDE files
vitis_workspace/_ide/
vitis_workspace/.rigel_lopper/

# Platform project — all generated from .xsa
vitis_workspace/RAPID/export/
vitis_workspace/RAPID/hw/
vitis_workspace/RAPID/logs/
vitis_workspace/RAPID/ps7_cortexa9_0/
vitis_workspace/RAPID/resources/
vitis_workspace/RAPID/zynq_fsbl/

# Application build output
vitis_workspace/testControl/build/
vitis_workspace/testControl/_ide/
vitis_workspace/systemControl/build/
vitis_workspace/systemControl/_ide/

# ============================================
# IP Packager generated files (keep source HDL)
# ============================================
hardware/ip_repo/src/top_clk_wiz_0/
hardware/ip_repo/src/top_processing_system7_0_0/
hardware/ip_repo/src/top_rst_clk_wiz_150M_0/
hardware/ip_repo/src/top_stepperDriver_0_0/

# ============================================
# Misc Xilinx generated files
# ============================================
*.str
*.wdb
*.wdf
*.xml
hd_visual/
.Xil/
webtalk/
webtalk_*
usage_statistics_webtalk.*

# Generated IP output in srcs (keep .xci, .bd, .xdc, .vhd, .v source files)
**/ip/*/sim/
**/ip/*/synth/
**/ip/*/sysc/
**/ipshared/
**/bd/*/ui/

# ============================================
# Local configuration files
# ============================================
.claude/*
