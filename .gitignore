# Vitis application build output
RAPID/motorDriver_SW/build/
RAPID/motorDriver_SW/compile_commands.json
RAPID/motorDriver_SW/vitis-comp.json
RAPID/motorDriver_SW/.cache/
RAPID/motorDriver_SW/.clangd

# Clangd / IDE caches (generated by Vitis)
.cache/
.clangd
compile_commands.json

# Vitis workspace files
.vitisWorkspace.json

