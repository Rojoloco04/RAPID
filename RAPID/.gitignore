# Vivado/Vitis build artifacts (handled by root .gitignore)
# This file kept minimal — see root .gitignore for full rules

# Build output
/build/
/export/

# Object and dependency files
*.o
*.d

# Logs
/logs/
*.log
*.jou

# Lock files
*.lock

# Binary artifacts
*.bin
*.pdi

# Vitis workspace
.vitisWorkspace.json

# IDE generated
_ide/logs/
_ide/.wsdata/